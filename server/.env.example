# =========================================================
# PIZZERÍA KIKIS POS — VARIABLES DEL SERVIDOR (ejemplo)
# Copia este archivo como server/.env y completa los valores.
# NO subas server/.env a git: contiene datos privados.
# =========================================================

# development | production
NODE_ENV=development

# Puerto del backend/API (el hosting suele definirlo solo)
PORT=3002

# Secreto para firmar las sesiones. OBLIGATORIO en producción.
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Ruta del archivo de base de datos SQLite.
# Vacío = server/pizzeria.db (desarrollo).
# En la nube debe estar en un disco persistente, ej: /data/pizzeria.db
DB_PATH=

# Contraseña del administrador SOLO para la primera vez
# (cuando la base de datos está vacía). Cámbiala luego.
ADMIN_INITIAL_PASSWORD=

# Dominios que pueden usar la API desde otro sitio, separados por coma.
# No hace falta si la web y la API están en el mismo dominio.
# Ej: https://mi-pizzeria.com,https://www.mi-pizzeria.com
CORS_ORIGINS=http://localhost:5177
